# ============================================
# OLLAMA CONFIGURATION
# ============================================
# Defaults (if not overridden elsewhere)
DEFAULT_OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
DEFAULT_OLLAMA_LLM_MODEL=llama2

# Runtime Configuration (overrides defaults if set)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_LLM_MODEL=qwen3-agent-4b:latest

# ============================================
# KNOWLEDGE BASE CONFIGURATION
# ============================================
# Defaults
DEFAULT_KB_NAME=ragtest_kb
DEFAULT_KB_DB_PATH=./chroma_db
DEFAULT_KB_CHUNK_SIZE=800
DEFAULT_KB_OVERLAP=150
DEFAULT_KB_BREAK_ON_SENTENCES=true

# Runtime Configuration (overrides defaults if set)
KB_NAME=ragtest_kb
KB_DB_PATH=./chroma_db
KB_CHUNK_SIZE=800
KB_OVERLAP=150
KB_BREAK_ON_SENTENCES=true

# ============================================
# DATA CONFIGURATION
# ============================================
# Defaults
DEFAULT_DATA_INPUT_DIR=./data
DEFAULT_DATA_SUPPORTED_FORMATS=.pdf,.txt,.md

# Runtime Configuration (overrides defaults if set)
DATA_INPUT_DIR=./data
DATA_SUPPORTED_FORMATS=.pdf,.txt,.md

# ============================================
# RETRIEVAL CONFIGURATION
# ============================================
# Defaults
DEFAULT_RETRIEVAL_TOP_K=5
DEFAULT_RETRIEVAL_MIN_SCORE=0.3
DEFAULT_RETRIEVAL_INCLUDE_METADATA=true

# Runtime Configuration (overrides defaults if set)
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3
RETRIEVAL_INCLUDE_METADATA=true

# ============================================
# LLM CONFIGURATION
# ============================================
# Defaults
DEFAULT_LLM_TEMPERATURE=0.7
DEFAULT_LLM_TOP_K=40
DEFAULT_LLM_TOP_P=0.9

# Runtime Configuration (overrides defaults if set)
LLM_TEMPERATURE=0.7
LLM_TOP_K=40
LLM_TOP_P=0.9

# ============================================
# APPLICATION CONFIGURATION
# ============================================
DEBUG=true
CONFIG_PATH=./config.yaml
STREAMLIT_PORT=8501
LOG_LEVEL=INFO

# ============================================
# NETWORK TIMEOUTS (seconds)
# ============================================
# Defaults
DEFAULT_OLLAMA_TIMEOUT=5
DEFAULT_EMBEDDINGS_TIMEOUT=30
DEFAULT_STREAMLIT_TIMEOUT=2

# Runtime Configuration (overrides defaults if set)
OLLAMA_TIMEOUT=5
EMBEDDINGS_TIMEOUT=30
STREAMLIT_TIMEOUT=2

# ============================================
# FALLBACK MODEL DEFAULTS
# ============================================
# Defaults
DEFAULT_HUGGINGFACE_MODEL=all-MiniLM-L6-v2
DEFAULT_OPENAI_MODEL=text-embedding-3-small

# Runtime Configuration (overrides defaults if set)
HUGGINGFACE_MODEL=all-MiniLM-L6-v2
OPENAI_MODEL=text-embedding-3-small

# ============================================
# ANALYSIS THRESHOLDS
# ============================================
# Chunk size analysis thresholds (0.0 to 1.0)
CHUNK_SIZE_RATIO_THRESHOLD_GOOD=0.9
CHUNK_SIZE_RATIO_THRESHOLD_OKAY=0.7
